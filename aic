#!/usr/bin/env bash
# =============================================================================
# aic — host-side CLI for aicontainer
# =============================================================================
# Thin shim around `@devcontainers/cli`. Resolves the aicontainer files
# relative to this script so both npm installs (npm install -g aicontainer)
# and git checkouts (~/.aicontainer + install.sh) work without configuration.
# Override with $AIC_HOME if you keep them somewhere unusual.
#
# This file is the entry point. The command code is in the modules in
# $AIC_HOME/lib/aic/ (see the load list below); this file loads them, then
# dispatches the command.
# =============================================================================
set -euo pipefail

# Resolve the real script directory, following symlinks (npm install -g
# creates one in the global bin dir). Works on macOS (BSD readlink, no -f)
# and Linux.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  link_dir="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$link_dir/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

AIC_HOME="${AIC_HOME:-$SCRIPT_DIR}"
# The modules in lib/aic/ read TEMPLATE_DIR and the cache below.
# shellcheck disable=SC2034
TEMPLATE_DIR="$AIC_HOME/template"
# Per-process cache of export_runtime_environment()'s bind-source probe. Set
# here so a value in the environment can never seed it.
# shellcheck disable=SC2034
aic_bind_source=""
# shellcheck disable=SC2034
aic_bind_source_for=""
# The --json mode of lib/aic/json.sh, and the latest version that the update
# check of lib/aic/versions.sh found. Set here so a value in the environment
# can never select JSON mode or seed the version.
# shellcheck disable=SC2034
aic_json_dir=""
# shellcheck disable=SC2034
aic_update_latest=""
# The AIC_PROJECT_NAME that this process inherited. aic exports its own value
# before Compose runs, so check_devcontainer_project_name() reads this copy to
# judge the environment that a direct Dev Containers start has.
# shellcheck disable=SC2034
if [ -n "${AIC_PROJECT_NAME+set}" ]; then aic_inherited_project_name_set=1; else aic_inherited_project_name_set=0; fi
# shellcheck disable=SC2034
aic_inherited_project_name="${AIC_PROJECT_NAME-}"

err()  { echo "aic: $*" >&2; }
# die: a refusal, a blocker, or a failure. Exit 1.
die()  { err "$*"; exit 1; }
# usage_die: a bad call (an unknown command, flag, or argument, or a missing or
# bad value). Exit 2, so a program can tell it from a refusal. Call it only
# while a command parses its arguments, before it reads or changes any state.
# Never use it for a security refusal: that is die.
usage_die() { err "$*"; exit 2; }
# flag_value <flag> [rest...]: refuse a flag that has no value after it.
flag_value() {
  [ "$#" -ge 2 ] || usage_die "$1 needs a value"
}
# require_no_args <command> [args...]: refuse any argument.
require_no_args() {
  local command="$1"
  shift
  [ "$#" -eq 0 ] || usage_die "aic $command takes no arguments (got: $1)"
}

# Run a lib/cli.mjs subcommand. lib/ is part of the install: when cli.mjs or a
# module it imports is missing, say so plainly instead of Node's stack trace.
# Either way the status is non-zero, so every caller still fails closed.
aic_helper () {
  local module
  if [ -f "$AIC_HOME/lib/cli.mjs" ]; then
    for module in $(sed -n "s|^import .* from '\./\([A-Za-z0-9._-]*\.mjs\)';\$|\1|p" "$AIC_HOME/lib/cli.mjs"); do
      [ -f "$AIC_HOME"/lib/"$module" ] || { module="lib/$module"; break; }
      module=""
    done
  else
    module="lib/cli.mjs"
  fi
  if [ -n "$module" ]; then
    err "incomplete aicontainer install: $module is missing in $AIC_HOME — reinstall aicontainer"
    return 2
  fi
  node "$AIC_HOME/lib/cli.mjs" "$@"
}

# Load the CLI modules from lib/aic/. The list is explicit and ordered. Never
# use a glob here: a glob would also source a file that somebody planted in
# lib/aic/. The modules only define functions and constants, so the order of
# the list does not change behavior. A missing or unreadable module fails
# closed and names the file, as aic_helper() does for lib/*.mjs.
for aic_module in json runtime identity selection versions template init-sync \
    validation status signing volumes lifecycle doctor help; do
  if [ ! -f "$AIC_HOME/lib/aic/$aic_module.sh" ]; then
    die "incomplete aicontainer install: lib/aic/$aic_module.sh is missing in $AIC_HOME — reinstall aicontainer"
  fi
  if [ ! -r "$AIC_HOME/lib/aic/$aic_module.sh" ]; then
    die "incomplete aicontainer install: lib/aic/$aic_module.sh is not readable in $AIC_HOME — reinstall aicontainer"
  fi
  # shellcheck source=/dev/null
  . "$AIC_HOME/lib/aic/$aic_module.sh"
done
unset aic_module

# Every command here, internal ones included, is in COMMANDS in lib/cli-spec.mjs.
# tests/test-aic-cli-spec.mjs checks the two lists and the help against each other.
case "${1:-help}" in
  init)    shift; cmd_init "$@" ;;
  sync)    shift; cmd_sync "$@" ;;
  doctor)  shift; cmd_doctor "$@" ;;
  status)  shift; cmd_status "$@" ;;
  validate) shift; cmd_validate "$@" ;;
  up)      shift; cmd_up "$@" ;;
  trust)   shift; cmd_trust "$@" ;;
  preflight) shift; cmd_preflight "$@" ;;
  check-drift) cmd_check_drift ;;   # internal: VS Code initializeCommand hook
  initialize) shift; cmd_initialize "$@" ;;  # internal: trusted host initialize hook
  __supports) shift; cmd_supports "$@" ;;  # internal: initializer capability probe
  signing) shift; cmd_signing "$@" ;;
  shell)   shift; cmd_shell "$@" ;;
  run)     shift; cmd_run "$@" ;;
  rebuild) shift; cmd_rebuild "$@" ;;
  down)    shift; cmd_down "$@" ;;
  destroy) shift; cmd_destroy "$@" ;;
  upgrade) shift; cmd_upgrade "$@" ;;
  completion) shift; cmd_completion "$@" ;;
  version|-v|--version) shift; cmd_version "$@" ;;
  help|-h|--help) [ "$#" -eq 0 ] || shift; require_no_args help "$@"; cmd_help ;;
  *) cmd_help >&2; usage_die "unknown command: $1" ;;
esac
